# Vertex AI (recommended). Text models resolve on the `global` endpoint;
# Veo and Lyria resolve regionally. Praetor handles the split for you.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=praetor-505914
GOOGLE_CLOUD_LOCATION=global

# Force the deterministic reasoner (no network, no credentials).
# PRAETOR_OFFLINE=1
